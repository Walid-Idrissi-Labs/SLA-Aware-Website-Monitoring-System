# ── SLA Monitor — frontend runtime config (Vite) ──────────────────────────────
# Copy to `.env.local` for local dev, and set the SAME keys in your Vercel
# project (Settings → Environment Variables).
#
# NOTE: none of these are secrets. Pool ID and Client ID are PUBLIC identifiers
# designed to ship in browser code — access still requires a valid password or
# Google login that Cognito verifies.

# API Gateway invoke URL  (Terraform output: api_gateway_url / cloudfront)
VITE_API_GATEWAY_URL=https://rzp9zsu9hb.execute-api.us-east-1.amazonaws.com

# Cognito App Client ID   (Terraform output: cognito_app_client_id)
VITE_COGNITO_CLIENT_ID=1rjr0fa3c4fbrgg9plgok9s0vu

# Cognito User Pool ID, e.g. us-east-1_XXXXXXXXX   <-- REQUIRED for the custom login
#   Get it from:  AWS Console → Cognito → User pools → (your pool) → "User pool ID"
#   or CLI:       aws cognito-idp list-user-pools --max-results 10
VITE_COGNITO_USER_POOL_ID=us-east-1_JDfGQ7FjE

# Cognito Hosted UI base URL (used only for the "Continue with Google" redirect),
# e.g. https://sla-monitor-auth.auth.us-east-1.amazoncognito.com
#   (Terraform output: cognito_hosted_ui_url)
VITE_COGNITO_HOSTED_UI_URL=https://sla-monitor-prod-auth.auth.us-east-1.amazoncognito.com
